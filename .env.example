# WorkTrack Pro install settings. Copy to .env on the server and fill in.
# .env is never committed; each institution's install has its own.

# Required in production: a long random string, unique per install.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Must stay False on a live server.
DEBUG=False

# Hosts are also checked against the Host management table (AllowedHost).
# Leave '*' to rely on that table, or list the domains here.
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://example.edu,https://www.example.edu
SITE_URL=https://example.edu

# HTTPS (turn on once the certificate works)
SECURE_COOKIES=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Database: sqlite (default), mysql or postgresql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Uploaded files
MEDIA_URL=/media/
MEDIA_ROOT=

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Background jobs (optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
