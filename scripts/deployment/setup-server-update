    echo ""
}

# ==============================================================================
# 4. ⏹️ STOP SERVER ENGINE
# ==============================================================================
stop_server_internal() {
    local stopped=false

    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            print_info "Sending graceful shutdown signal (SIGTERM) to PID $pid..."
            kill "$pid" 2>/dev/null || true
            
            # Wait up to 5 seconds for graceful exit
            local count=0
            while kill -0 "$pid" 2>/dev/null && [ $count -lt 5 ]; do
                sleep 1
                ((count++))
            done

            if kill -0 "$pid" 2>/dev/null; then
                print_warn "Process didn't stop gracefully. Forcing termination (SIGKILL)..."
                kill -9 "$pid" 2>/dev/null || true
                sleep 1
            fi
            stopped=true
            print_success "Server process $pid stopped."
        fi
        rm -f "$PID_FILE"
    fi

    # Fallback check for any process listening on 8000 or running runserver
    if command -v fuser &>/dev/null; then
        if fuser 8000/tcp &>/dev/null; then
            print_info "Stopping process occupying port 8000..."
            fuser -k 8000/tcp >/dev/null 2>&1 || true
            stopped=true
        fi
    fi

    pkill -f "manage.py runserver" 2>/dev/null || true

    if [ "$stopped" = true ]; then
        print_success "Application server stopped successfully."
    else
        print_info "No active server process detected."
    fi
}

stop_server() {
    draw_header
    printf '%b\n' "  ${YELLOW}${BOLD}⏹ 4. STOP APPLICATION SERVER${NC}"
    printf '%b\n' "  ────────────────────────────────────────────────────"
    stop_server_internal
    echo ""
}

