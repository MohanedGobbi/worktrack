# ── Virtual Environment & Python Interpreter Handling ────────────────────────
verify_and_repair_venv() {
    local broken=false
    if [ -d "$VENV_DIR" ]; then
        if [ ! -f "$VENV_DIR/bin/python" ]; then
            broken=true
        elif ! "$VENV_DIR/bin/python" -c "import sys" &>/dev/null; then
            broken=true
        else
            local venv_path=""
            if [ -f "$VENV_DIR/bin/activate" ]; then
                venv_path=$(grep -E "^export VIRTUAL_ENV=" "$VENV_DIR/bin/activate" 2>/dev/null | head -n1 | sed -E 's/.*=["'\''"]?(.*)["'\''"]?/\1/' | tr -d '"' | tr -d "'")
            fi
            if [ -n "$venv_path" ] && [ "$venv_path" != "$VENV_DIR" ]; then
                broken=true
            fi
        fi

        if [ "$broken" = true ]; then
            print_warn "Virtual environment location mismatch or corruption detected!"
            print_info "Auto-repairing Python virtual environment (.venv) at $VENV_DIR ..."
            rm -rf "$VENV_DIR"
            python3 -m venv "$VENV_DIR"
            "$VENV_DIR/bin/pip" install --upgrade pip -q 2>/dev/null || true
            if [ -f "$PROJECT_DIR/requirements.txt" ]; then
                print_info "Re-installing requirements into repaired .venv..."
                "$VENV_DIR/bin/pip" install -r "$PROJECT_DIR/requirements.txt" -q 2>/dev/null || "$VENV_DIR/bin/pip" install -r "$PROJECT_DIR/requirements.txt"
            fi
            print_success "Virtual environment repaired successfully!"
        fi
    fi
}

get_python_bin() {
    verify_and_repair_venv
    if [ -f "$VENV_DIR/bin/python" ]; then
        echo "$VENV_DIR/bin/python"
    elif command -v python3 &>/dev/null; then
        echo "python3"
    else
