    print_info "Cleaning virtual environment (.venv)..."
    if [ -d "$VENV_DIR" ]; then
        rm -rf "$VENV_DIR"
        print_success "Virtual environment (.venv) removed."
    fi

    print_info "Cleaning static assets and build artifacts..."
    rm -rf "$STATICFILES_DIR" "$PROJECT_DIR/build" "$PROJECT_DIR/dist" 2>/dev/null || true
    print_success "Static and build artifacts cleared."

    print_info "Cleaning logs and temporary runtime files..."
    rm -rf "$LOG_DIR"/* /tmp/django_server.log "$PID_FILE" "$PROJECT_DIR/.cleanup_report_tmp.json" /tmp/translation_last_updated.txt 2>/dev/null || true
