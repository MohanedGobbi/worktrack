# ==============================================================================
# 3. ▶️ START SERVER ENGINE
# ==============================================================================
start_server_internal() {
    cd "$PROJECT_DIR"
    
    # Check if already running
    if [ -f "$PID_FILE" ]; then
        local old_pid
        old_pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            print_warn "Server is already running with PID $old_pid"
            return 0
        fi
    fi

    # Check port 8000 availability
    if command -v fuser &>/dev/null; then
        fuser -k 8000/tcp >/dev/null 2>&1 || true
    fi
    pkill -f "manage.py runserver 0.0.0.0:8000" 2>/dev/null || true
    sleep 1

    # Validate activation before start using Standalone Hex Core v2
    if [ ! -f "$PROD_LOCK_FILE" ]; then
        print_info "First startup detected — applying Standalone 1X Security Core (Hex Core v2)..."
        execute_embedded_hex_activation
    else
        python_cmd -c "import os, django; os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'worktrack_pro.settings'); django.setup(); from core.middleware.prod_guard import _verify_license; _verify_license()" &>/dev/null || {
            print_warn "Re-binding machine activation lock (Hex Core v2)..."
            execute_embedded_hex_activation
        }
    fi

    local py_bin
    py_bin=$(get_python_bin)
    "$py_bin" manage.py runserver 0.0.0.0:8000 > /tmp/django_server.log 2>&1 &
    local server_pid=$!
    echo "$server_pid" > "$PID_FILE"
    sleep 2

    if kill -0 "$server_pid" 2>/dev/null; then
        print_success "Application Server started successfully! (PID: $server_pid)"
        print_info "Access points:"
        print_info "  Site Portal:  http://localhost:8000"
        print_info "  Admin Portal: http://localhost:8000/admin"
        print_info "  Server Log:   /tmp/django_server.log"
    else
        print_error "Failed to start server. Output from /tmp/django_server.log:"
        if [ -f "/tmp/django_server.log" ]; then
            tail -n 20 "/tmp/django_server.log"
        fi
        return 1
    fi
}

