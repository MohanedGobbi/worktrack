    echo ""

    local pass_count=0
    local fail_count=0

    diag_item() {
        local status=$1
        local title=$2
        local detail=$3
        if [ "$status" = "PASS" ]; then
            printf "  ${GREEN}[PASS]${NC} %-28s : %s\n" "$title" "$detail"
            ((pass_count++))
        else
            printf "  ${RED}[FAIL]${NC} %-28s : %s\n" "$title" "$detail"
            ((fail_count++))
        fi
    }

    # 1. Python Environment
    if command -v python3 &>/dev/null; then
        diag_item "PASS" "Python Runtime" "$(python3 --version)"
    else
        diag_item "FAIL" "Python Runtime" "python3 not found in PATH"
    fi

    # 2. Virtual Environment
    if [ -f "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c "import sys" &>/dev/null; then
        diag_item "PASS" "Virtual Environment" "Active & Functional ($VENV_DIR)"
    else
        diag_item "FAIL" "Virtual Environment" "Missing or corrupted (.venv)"
    fi

    # 3. Core Dependencies
    if python_cmd -c "import django, gunicorn, sqlite3" &>/dev/null; then
        diag_item "PASS" "Core Dependencies" "Django & Gunicorn installed"
    else
        diag_item "FAIL" "Core Dependencies" "Missing required Python libraries"
    fi

    # 4. Database File & Read/Write
    if [ -f "$DB_FILE" ] && [ -w "$DB_FILE" ]; then
        diag_item "PASS" "Database File" "Writable SQLite database found"
    else
        diag_item "FAIL" "Database File" "db.sqlite3 missing or not writable"
    fi

    # 5. Required Directories
    local missing_dirs=()
    for d in "$MEDIA_DIR" "$STATICFILES_DIR" "$LOG_DIR" "$BACKUP_DIR"; do
        [ ! -d "$d" ] && missing_dirs+=("$(basename "$d")")
    done
    if [ ${#missing_dirs[@]} -eq 0 ]; then
        diag_item "PASS" "Directory Structure" "All required directories exist"
    else
        diag_item "FAIL" "Directory Structure" "Missing directories: ${missing_dirs[*]}"
    fi

    # 6. Environment Configuration
    if [ -f "$ENV_FILE" ]; then
        diag_item "PASS" "Configuration (.env)" "Found & loadable"
    else
        diag_item "FAIL" "Configuration (.env)" ".env file missing"
    fi

    # 7. Django Health Check
    if python_cmd manage.py check &>/dev/null; then
        diag_item "PASS" "Django Application Check" "System check passed without errors"
    else
        diag_item "FAIL" "Django Application Check" "Django check reported issues"
    fi

    # 8. Activation & Machine Lock
    if [ -f "$PROD_LOCK_FILE" ]; then
        if python_cmd -c "import os, django; os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'worktrack_pro.settings'); django.setup(); from core.middleware.prod_guard import _verify_license; _verify_license()" &>/dev/null; then
            diag_item "PASS" "Activation & License" "1X Plan valid & bound to machine"
        else
            diag_item "FAIL" "Activation & License" "Hardware signature mismatch (.prod_lock)"
        fi
    else
        diag_item "PASS" "Activation & License" "Development mode (unlocked)"
    fi

    # 9. Port Availability
    if command -v fuser &>/dev/null && fuser 8000/tcp &>/dev/null; then
        diag_item "PASS" "Port 8000 Status" "Occupied by active server process"
    else
        diag_item "PASS" "Port 8000 Status" "Available for binding"
    fi

    echo ""
    printf '%b\n' "  ────────────────────────────────────────────────────"
    printf '%b\n' "  Diagnostic Results: ${GREEN}${pass_count} Passed${NC} | ${RED}${fail_count} Failed${NC}"
    echo ""
}

# ==============================================================================
# 8. 📦 BACKUP / RESTORE SUB-ENGINE
# ==============================================================================
backup_restore_menu() {
    draw_header
    printf '%b\n' "  ${CYAN}${BOLD}📦 8. BACKUP & RESTORE MANAGEMENT${NC}"
    printf '%b\n' "  ────────────────────────────────────────────────────"
    echo ""
    printf '%b\n' "    ${GREEN}1.${NC} 💾 Create Full Backup Now"
    printf '%b\n' "    ${GREEN}2.${NC} 📋 List Existing Backups"
    printf '%b\n' "    ${GREEN}3.${NC} 🔄 Restore System from Backup"
    printf '%b\n' "    ${GREEN}0.${NC} ⬅️ Return to Main Menu"
    echo ""
    read -p "  Select an option [0-3]: " sub_opt
    echo ""

    ensure_required_directories

    case "$sub_opt" in
        1)
            local ts
            ts=$(date +%Y%m%d_%H%M%S)
            local archive="$BACKUP_DIR/backup_${ts}.tar.gz"
            print_info "Creating full system backup..."
            if tar -czf "$archive" -C "$PROJECT_DIR" db.sqlite3 .env media 2>/dev/null; then
                print_success "Backup created successfully -> $(basename "$archive")"
            else
                print_error "Failed to create full backup."
            fi
            ;;
        2)
            print_info "Listing available backups in $BACKUP_DIR:"
            echo ""
            if ls "$BACKUP_DIR"/*.tar.gz &>/dev/null || ls "$BACKUP_DIR"/*.bak &>/dev/null; then
                ls -lh "$BACKUP_DIR"/*.tar.gz "$BACKUP_DIR"/*.bak 2>/dev/null | awk '{print "    " $5 "\t" $6 " " $7 " " $8 "\t" $9}'
            else
                print_warn "No backups found."
            fi
            ;;
        3)
            print_info "Available backup files:"
            local files=("$BACKUP_DIR"/*.tar.gz "$BACKUP_DIR"/*.bak)
            if [ ! -f "${files[0]}" ]; then
                print_warn "No backup files available to restore."
                return 0
            fi

            local idx=1
            for f in "${files[@]}"; do
                [ -f "$f" ] || continue
                echo "    $idx) $(basename "$f")"
                ((idx++))
            done
            echo ""
            read -p "  Select backup number to restore [1-$((idx-1))]: " sel
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -lt "$idx" ]; then
                local chosen="${files[$((sel-1))]}"
                print_warn "Restoring from: $(basename "$chosen")"
                read -p "  Confirm restore? Current database will be overwritten! (y/N): " confirm_res
                if [[ "$confirm_res" =~ ^[Yy]$ ]]; then
                    if [[ "$chosen" == *.tar.gz ]]; then
                        tar -xzf "$chosen" -C "$PROJECT_DIR"
                    elif [[ "$chosen" == *.bak ]]; then
                        cp "$chosen" "$DB_FILE"
                    fi
                    print_success "System restored successfully!"
                fi
            else
                print_error "Invalid selection."
            fi
            ;;
        0) return 0 ;;
        *) print_error "Invalid choice." ;;
    esac
}

# ==============================================================================
# 9. ⚙️ CONFIGURATION SUB-ENGINE
# ==============================================================================
configuration_menu() {
    draw_header
    printf '%b\n' "  ${CYAN}${BOLD}⚙️ 9. SYSTEM CONFIGURATION & QUOTAS${NC}"
    printf '%b\n' "  ────────────────────────────────────────────────────"
    echo ""
    printf '%b\n' "    ${GREEN}1.${NC} 📊 View & Manage Security Limits & Quotas"
    printf '%b\n' "    ${GREEN}2.${NC} 🔒 Sanitized Environment (.env) Overview"
    printf '%b\n' "    ${GREEN}3.${NC} ⚡ Toggle Debug Mode"
    printf '%b\n' "    ${GREEN}0.${NC} ⬅️ Return to Main Menu"
    echo ""
    read -p "  Select an option [0-3]: " cfg_opt
    echo ""

    case "$cfg_opt" in
        1)
            execute_embedded_hex_activation
            echo ""
            echo "No limits configured (system is unlimited)"
            ;;
        2)
            print_info "Current Configuration (.env sanitized):"
            echo ""
            if [ -f "$ENV_FILE" ]; then
                grep -E -v "^SECRET_KEY|^DB_PASSWORD" "$ENV_FILE" | sed 's/^/    /' || true
            else
                print_warn ".env file not found."
            fi
            ;;
        3)
            if [ -f "$ENV_FILE" ]; then
                if grep -q "DEBUG=True" "$ENV_FILE"; then
                    sed -i 's/DEBUG=True/DEBUG=False/g' "$ENV_FILE"
                    print_success "Debug Mode set to: ${BOLD}False${NC} (Production)"
                else
                    sed -i 's/DEBUG=False/DEBUG=True/g' "$ENV_FILE"
                    print_warn "Debug Mode set to: ${BOLD}True${NC} (Development)"
                fi
            else
                print_error ".env file missing."
            fi
            ;;
        0) return 0 ;;
        *) print_error "Invalid selection." ;;
    esac
}

