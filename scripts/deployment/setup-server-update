update_system() {
    draw_header
    printf '%b\n' "  ${BLUE}${BOLD}🔄 6. UPDATE SYSTEM & CODE BASE${NC}"
    printf '%b\n' "  ────────────────────────────────────────────────────"
    print_info "Starting safe system update workflow..."
    echo ""

    ensure_required_directories
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local update_bak="$BACKUP_DIR/update_backup_${timestamp}.tar.gz"

    # Step 1: Create backup prior to update
    print_header "1/5 Creating Safety Backup..."
    if tar -czf "$update_bak" -C "$PROJECT_DIR" db.sqlite3 .env media 2>/dev/null; then
        print_success "Safety backup created -> $(basename "$update_bak")"
    else
        print_warn "Partial backup created."
    fi

    # Step 2: Git update if repository
    print_header "2/5 Checking Source Code Updates..."
    if [ -d "$PROJECT_DIR/.git" ]; then
        if command -v git &>/dev/null; then
            print_info "Fetching latest code from Git..."
            git pull || print_warn "Git pull failed or no upstream branch configured."
        fi
    else
        print_info "Not a Git repository. Source code update skipped."
    fi

    # Step 3: Update dependencies
    print_header "3/5 Updating Dependencies..."
    if [ -f "$PROJECT_DIR/requirements.txt" ]; then
        "$VENV_DIR/bin/pip" install -r "$PROJECT_DIR/requirements.txt" -q 2>/dev/null || true
        print_success "Dependencies updated."
    fi

    # Step 4: Run Migrations & Asset Collection
    print_header "4/5 Executing Database Migrations & Asset Collection..."
    if python_cmd manage.py migrate --noinput && python_cmd manage.py collectstatic --noinput >/dev/null 2>&1; then
        print_success "Migrations and static asset collection completed."
    else
        print_error "Update step failed! Initiating automatic ROLLBACK..."
        if [ -f "$update_bak" ]; then
            tar -xzf "$update_bak" -C "$PROJECT_DIR"
            print_success "Rollback successful. Restored database and environment from safety backup."
        fi
        return 1
    fi

    # Step 5: Re-bind License and Restart Server if needed
    print_header "5/5 Re-validating Activation & Restarting Server (Hex Core v2)..."
    execute_embedded_hex_activation

    if [ -f "$PID_FILE" ]; then
        print_info "Restarting server..."
        stop_server_internal
        sleep 1
        start_server_internal
    fi

    echo ""
    print_success "✨ System update completed successfully!"
}

